# AI Location Analysis Backend Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="AI Location Analysis"
API_V1_PREFIX="/api/v1"

HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (JSON array of strings)
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Image Intake Validation Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=["image/jpeg", "image/png", "image/webp"]

# External API Credentials & Configuration (Backend-Only, NEVER exposed to client)
# 1. Mapillary API v4:
#    Register for a free account at https://www.mapillary.com/dashboard/developers
#    Create a Client Token and paste below (e.g. MLY|1234567890|abcdef...)
#    Leave blank if not using Mapillary; system falls back to Wikimedia Commons automatically.
MAPILLARY_CLIENT_TOKEN=""

# 2. Wikimedia Commons API:
#    Free public REST API, no API key required.
#    Provide a polite user agent identifying your tool per Wikimedia guidelines:
WIKIMEDIA_USER_AGENT="AILocationAnalysis/1.0 (educational-geolocation-system; mailto:contact@example.com)"

# 3. Detection Confidence Threshold (minimum composite score to verify a landmark, default 0.35)
DETECTION_CONFIDENCE_THRESHOLD=0.35
